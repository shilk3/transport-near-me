{
  "buildCommand": "node scripts/build-network.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "includeFiles": "data/*.json",
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "regions": [
    "syd1"
  ],
  "crons": [
    {
      "path": "/api/refresh",
      "schedule": "23 16 * * *"
    }
  ]
}
